.player-page {
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  padding: 16rpx 36rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #eef2ee;
}

.player-content {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
}

.player-artwork {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto;
  overflow: hidden;
  flex: none;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 52rpx rgba(35, 58, 47, 0.14);
}

.player-heading {
  display: flex;
  align-items: center;
  flex: none;
  flex-direction: column;
  margin-top: 16rpx;
  text-align: center;
}

.player-heading__title {
  max-width: 100%;
  overflow: hidden;
  color: #263a30;
  font-size: 36rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-heading__subtitle,
.player-heading__artist,
.player-heading__album {
  margin-top: 5rpx;
  font-size: 24rpx;
}

.player-heading__subtitle,
.player-heading__album {
  color: #859189;
}

.player-heading__artist {
  color: #527363;
  font-weight: 600;
}

.lyrics-section {
  min-height: 0;
  margin-top: 14rpx;
  flex: 1 1 auto;
}

.lyrics-view {
  height: 100%;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.52);
}

.lyrics-list {
  padding: 220rpx 28rpx;
}

.lyrics-line {
  display: block;
  padding: 14rpx 0;
  color: #8b9690;
  font-size: 27rpx;
  line-height: 1.55;
  text-align: center;
  transition:
    color 0.2s,
    transform 0.2s;
}

.lyrics-line--active {
  color: #2d4a3c;
  font-size: 31rpx;
  font-weight: 650;
  transform: scale(1.02);
}

.lyrics-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #8b9690;
  font-size: 25rpx;
}

.progress-area {
  margin-top: 12rpx;
  flex: none;
}

.progress-area slider {
  margin-right: -10rpx;
  margin-left: -10rpx;
}

.progress-area__times {
  display: flex;
  justify-content: space-between;
  color: #75847c;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.player-controls {
  margin-top: 8rpx;
  flex: none;
  text-align: center;
}

.mode-button,
.queue-button,
.transport-button,
.player-empty__button {
  border: 0;
}

.mode-button::after,
.queue-button::after,
.transport-button::after,
.player-empty__button::after {
  border: 0;
}

.player-toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.mode-button,
.queue-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #597064;
  background: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  line-height: 64rpx;
}

.mode-button {
  min-width: 210rpx;
}

.queue-button {
  min-width: 176rpx;
}

.mode-button__queue {
  margin-left: 14rpx;
  color: #8c9891;
}

.transport-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  gap: 54rpx;
}

.transport-button {
  width: 92rpx;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  color: #3c5c4d;
  background: rgba(255, 255, 255, 0.66);
  font-size: 34rpx;
  font-weight: 650;
  line-height: 92rpx;
}

.transport-button--primary {
  width: 122rpx;
  height: 122rpx;
  color: #fff;
  background: #456756;
  font-size: 39rpx;
  line-height: 122rpx;
  box-shadow: 0 14rpx 34rpx rgba(48, 78, 63, 0.22);
}

.player-error {
  display: block;
  margin-top: 20rpx;
  color: #a45d54;
  font-size: 22rpx;
}

.player-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78vh;
  flex-direction: column;
  text-align: center;
}

.player-empty__title {
  color: #294037;
  font-size: 34rpx;
  font-weight: 650;
}

.player-empty__description {
  margin-top: 18rpx;
  color: #839088;
  font-size: 25rpx;
  line-height: 1.7;
}

.player-empty__button {
  margin-top: 34rpx;
  padding: 0 46rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #4b6e5d;
  font-size: 25rpx;
  line-height: 78rpx;
}

@media (max-height: 700px) {
  .player-page {
    padding-top: 8rpx;
    padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  }

  .player-artwork {
    width: 300rpx;
    height: 300rpx;
    border-radius: 28rpx;
  }

  .player-heading {
    margin-top: 8rpx;
  }

  .player-heading__title {
    font-size: 34rpx;
  }

  .player-heading__subtitle,
  .player-heading__artist,
  .player-heading__album {
    margin-top: 3rpx;
    font-size: 22rpx;
  }

  .lyrics-section {
    margin-top: 8rpx;
  }

  .progress-area {
    margin-top: 6rpx;
  }

  .player-controls {
    margin-top: 4rpx;
  }

  .mode-button,
  .queue-button {
    line-height: 56rpx;
  }

  .transport-controls {
    margin-top: 6rpx;
  }
}
