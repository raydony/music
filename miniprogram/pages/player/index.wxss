.player-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 42rpx calc(38rpx + env(safe-area-inset-bottom));
  background: #eef2ee;
}

.player-artwork {
  width: 480rpx;
  height: 480rpx;
  margin: 8rpx auto 0;
  overflow: hidden;
  border-radius: 38rpx;
  box-shadow: 0 28rpx 70rpx rgba(35, 58, 47, 0.16);
}

.player-heading {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 34rpx;
  text-align: center;
}

.player-heading__title {
  max-width: 100%;
  overflow: hidden;
  color: #263a30;
  font-size: 40rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-heading__subtitle,
.player-heading__artist,
.player-heading__album {
  margin-top: 9rpx;
  font-size: 24rpx;
}

.player-heading__subtitle,
.player-heading__album {
  color: #859189;
}

.player-heading__artist {
  color: #527363;
  font-weight: 600;
}

.lyrics-view {
  height: 330rpx;
  margin-top: 34rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.52);
}

.lyrics-list {
  padding: 136rpx 28rpx;
}

.lyrics-line {
  display: block;
  padding: 14rpx 0;
  color: #8b9690;
  font-size: 27rpx;
  line-height: 1.55;
  text-align: center;
  transition:
    color 0.2s,
    transform 0.2s;
}

.lyrics-line--active {
  color: #2d4a3c;
  font-size: 31rpx;
  font-weight: 650;
  transform: scale(1.02);
}

.lyrics-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #8b9690;
  font-size: 25rpx;
}

.progress-area {
  margin-top: 28rpx;
}

.progress-area slider {
  margin-right: -10rpx;
  margin-left: -10rpx;
}

.progress-area__times {
  display: flex;
  justify-content: space-between;
  color: #75847c;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.player-controls {
  margin-top: 12rpx;
  text-align: center;
}

.mode-button,
.queue-button,
.transport-button,
.player-empty__button {
  border: 0;
}

.mode-button::after,
.queue-button::after,
.transport-button::after,
.player-empty__button::after {
  border: 0;
}

.player-toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.mode-button,
.queue-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #597064;
  background: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  line-height: 64rpx;
}

.mode-button {
  min-width: 210rpx;
}

.queue-button {
  min-width: 176rpx;
}

.mode-button__queue {
  margin-left: 14rpx;
  color: #8c9891;
}

.transport-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  gap: 54rpx;
}

.transport-button {
  width: 92rpx;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  color: #3c5c4d;
  background: rgba(255, 255, 255, 0.66);
  font-size: 34rpx;
  font-weight: 650;
  line-height: 92rpx;
}

.transport-button--primary {
  width: 122rpx;
  height: 122rpx;
  color: #fff;
  background: #456756;
  font-size: 39rpx;
  line-height: 122rpx;
  box-shadow: 0 14rpx 34rpx rgba(48, 78, 63, 0.22);
}

.player-error {
  display: block;
  margin-top: 20rpx;
  color: #a45d54;
  font-size: 22rpx;
}

.player-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78vh;
  flex-direction: column;
  text-align: center;
}

.player-empty__title {
  color: #294037;
  font-size: 34rpx;
  font-weight: 650;
}

.player-empty__description {
  margin-top: 18rpx;
  color: #839088;
  font-size: 25rpx;
  line-height: 1.7;
}

.player-empty__button {
  margin-top: 34rpx;
  padding: 0 46rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #4b6e5d;
  font-size: 25rpx;
  line-height: 78rpx;
}
