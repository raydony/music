<view class="page page--with-mini-player">
  <view class="page-heading">
    <text class="eyebrow">Categories</text>
    <text class="page-title">音乐分类</text>
    <text class="page-description">按梵呗、赞偈、诵经等内容类型探索曲库</text>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在载入分类…</view>
  <empty-state
    wx:elif="{{errorMessage}}"
    text="{{errorMessage}}"
    action-text="重新加载"
    bind:retry="retry"
  />
  <empty-state wx:elif="{{!categories.length}}" text="暂无分类" />
  <view wx:else class="category-list">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="surface category-item"
      aria-role="button"
      aria-label="查看 {{item.name}} 分类"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      bindtap="openCategory"
    >
      <view class="category-item__main">
        <text class="category-item__name">{{item.name}}</text>
        <text class="category-item__description">{{item.description || '静待更多内容收录'}}</text>
      </view>
      <view class="category-item__side">
        <text>{{item.publishedTrackCount}} 首</text>
        <text class="category-item__arrow">›</text>
      </view>
    </view>
  </view>
  <mini-player />
</view>
