.play-queue {
  position: fixed;
  z-index: 200;
  inset: 0;
}

.play-queue__mask {
  position: absolute;
  inset: 0;
  background: rgba(24, 35, 30, 0.34);
}

.play-queue__sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  border-radius: 32rpx 32rpx 0 0;
  background: #f8faf8;
  box-shadow: 0 -20rpx 60rpx rgba(31, 48, 40, 0.16);
  padding-bottom: env(safe-area-inset-bottom);
}

.play-queue__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 22rpx;
  border-bottom: 1rpx solid #e9eeea;
}

.play-queue__title {
  color: #293b32;
  font-size: 31rpx;
  font-weight: 650;
}

.play-queue__count {
  margin-left: 14rpx;
  color: #87938c;
  font-size: 22rpx;
}

.play-queue__close {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: #64746b;
  background: #edf1ee;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.play-queue__close::after,
.play-queue__item::after {
  border: 0;
}

.play-queue__list {
  height: 60vh;
  max-height: 760rpx;
}

.play-queue__item {
  display: flex;
  align-items: center;
  width: auto;
  min-height: 104rpx;
  margin: 0 24rpx;
  padding: 16rpx 14rpx;
  border: 0;
  border-bottom: 1rpx solid #e9eeea;
  border-radius: 0;
  color: inherit;
  background: transparent;
  line-height: normal;
  text-align: left;
}

.play-queue__item--current {
  color: #3f6753;
  background: #edf4ef;
}

.play-queue__indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  flex: 0 0 68rpx;
  color: #8b9690;
  font-size: 21rpx;
}

.play-queue__item--current .play-queue__indicator {
  color: #456c58;
  font-weight: 650;
}

.play-queue__info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.play-queue__track-title,
.play-queue__artist {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.play-queue__track-title {
  color: #2d3f36;
  font-size: 27rpx;
  font-weight: 600;
}

.play-queue__item--current .play-queue__track-title {
  color: #3f6753;
}

.play-queue__artist {
  margin-top: 7rpx;
  color: #87938c;
  font-size: 22rpx;
}

.play-queue__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  color: #87938c;
  font-size: 25rpx;
}
