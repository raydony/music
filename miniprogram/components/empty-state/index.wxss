.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
  padding: 40rpx;
  color: #87928c;
}

.empty-state__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #557164;
  background: #e8ede8;
  font-size: 52rpx;
  line-height: 1;
}

.empty-state__text {
  margin-top: 22rpx;
  font-size: 26rpx;
}

.empty-state__button {
  margin-top: 28rpx;
  padding: 0 32rpx;
  border: 0;
  border-radius: 999rpx;
  color: #fff;
  background: #496b5b;
  font-size: 25rpx;
  line-height: 68rpx;
}

.empty-state__button::after {
  border: 0;
}
