page {
  min-height: 100%;
  background: #f4f6f2;
  color: #26352f;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.page--with-mini-player {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.page-section {
  margin-top: 54rpx;
}

.surface {
  overflow: hidden;
  border: 1rpx solid rgba(53, 81, 68, 0.06);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(37, 59, 49, 0.045);
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
  color: #7d8b83;
  font-size: 26rpx;
}

.list-footer {
  padding: 30rpx 0 16rpx;
  color: #929b96;
  font-size: 23rpx;
  text-align: center;
}

.eyebrow {
  display: block;
  color: #688073;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.page-title {
  display: block;
  margin-top: 10rpx;
  color: #20322a;
  font-size: 48rpx;
  font-weight: 650;
  line-height: 1.25;
}

.page-description {
  display: block;
  margin-top: 14rpx;
  color: #75837c;
  font-size: 26rpx;
  line-height: 1.7;
}

button {
  font-family: inherit;
}
